rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // ---------------------------------------------------------
    // User Profiles
    // ---------------------------------------------------------
    function isValidUser(data) {
      return data.displayName is string && data.displayName.size() <= 100
          && data.updatedAt == request.time;
    }

    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if false; // Profiles shouldn't be publicly listable
      allow create, update: if isOwner(userId) && isValidUser(incoming());
    }

    // ---------------------------------------------------------
    // Tasks
    // ---------------------------------------------------------
    function isValidTask(data) {
      return data.title is string && data.title.size() <= 200
          && data.status in ['pending', 'in-progress', 'completed']
          && data.energyReq in ['low', 'medium', 'high']
          && data.ownerId == request.auth.uid
          && data.createdAt is timestamp
          && data.updatedAt is timestamp;
    }

    match /tasks/{taskId} {
      allow get: if isSignedIn() && existing().ownerId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn() && isValidTask(incoming()) && incoming().createdAt == request.time;
      allow update: if isSignedIn() && existing().ownerId == request.auth.uid && isValidTask(incoming())
                    && incoming().updatedAt == request.time;
      allow delete: if isSignedIn() && existing().ownerId == request.auth.uid;
    }

    // ---------------------------------------------------------
    // Goals
    // ---------------------------------------------------------
    function isValidGoal(data) {
      return data.title is string && data.title.size() <= 200
          && data.status in ['active', 'achieved', 'paused']
          && data.ownerId == request.auth.uid;
    }

    match /goals/{goalId} {
      allow get: if isSignedIn() && existing().ownerId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn() && isValidGoal(incoming());
      allow update: if isSignedIn() && existing().ownerId == request.auth.uid && isValidGoal(incoming());
      allow delete: if isSignedIn() && existing().ownerId == request.auth.uid;
    }

    // ---------------------------------------------------------
    // Pods (Accountability Groups)
    // ---------------------------------------------------------
    match /pods/{podId} {
      allow read: if isSignedIn() && (request.auth.uid in resource.data.members);
      allow create: if isSignedIn() && (request.auth.uid in request.resource.data.members);
      allow update: if isSignedIn() && (request.auth.uid in resource.data.members);
    }

    // ---------------------------------------------------------
    // Relationships (Social Mapping)
    // ---------------------------------------------------------
    function isValidRelationship(data) {
      return data.contactName is string && data.contactName.size() <= 100
          && data.userId == request.auth.uid
          && data.strength is number && data.strength >= 0 && data.strength <= 100;
    }

    match /relationships/{relId} {
      allow read, write: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid) 
                         && (request.resource == null || request.resource.data.userId == request.auth.uid);
    }

    // ---------------------------------------------------------
    // Focus Sessions
    // ---------------------------------------------------------
    match /focusSessions/{sessionId} {
      allow read, write: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid)
                         && (request.resource == null || request.resource.data.userId == request.auth.uid);
    }

    // ---------------------------------------------------------
    // Collab Sessions
    // ---------------------------------------------------------
    match /collabSessions/{sessionId} {
      allow read, create, update: if isSignedIn() && (
        (resource != null && request.auth.uid in resource.data.participants) ||
        (request.resource != null && request.auth.uid in request.resource.data.participants)
      );
    }

    // ---------------------------------------------------------
    // GoalDNA
    // ---------------------------------------------------------
    match /goalDNA/{dnaId} {
      allow read, write: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid)
                         && (request.resource == null || request.resource.data.userId == request.auth.uid);
    }

    // ---------------------------------------------------------
    // Memories
    // ---------------------------------------------------------
    match /memories/{memoryId} {
      allow read, write: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid)
                         && (request.resource == null || request.resource.data.userId == request.auth.uid);
    }

    // ---------------------------------------------------------
    // Habits
    // ---------------------------------------------------------
    match /habits/{habitId} {
      allow read, write: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid)
                         && (request.resource == null || request.resource.data.userId == request.auth.uid);
    }

    // ---------------------------------------------------------
    // Reflections
    // ---------------------------------------------------------
    match /reflections/{reflectionId} {
      allow read, write: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid)
                         && (request.resource == null || request.resource.data.userId == request.auth.uid);
    }

    match /reciprocity/{recId} {
      allow read, write: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid)
                         && (request.resource == null || request.resource.data.userId == request.auth.uid);
    }

    match /karma/{karmaId} {
      allow read, write: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid)
                         && (request.resource == null || request.resource.data.userId == request.auth.uid);
    }

    match /energyMaps/{mapId} {
      allow read, write: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid)
                         && (request.resource == null || request.resource.data.userId == request.auth.uid);
    }

    match /brainstorms/{bsId} {
      allow read, write: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid)
                         && (request.resource == null || request.resource.data.userId == request.auth.uid);
    }
  }
}
